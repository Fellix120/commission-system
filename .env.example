APP_NAME="Commission Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Australia/Sydney
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL - matches a default XAMPP/WAMP/MAMP phpMyAdmin install.
# Create the database in phpMyAdmin first (utf8mb4_unicode_ci), then migrate.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=commission_dashboard
DB_USERNAME=root
DB_PASSWORD=

# MAMP on macOS uses port 8889 and password "root".
# Some hosts need DB_HOST=localhost instead of 127.0.0.1.

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
